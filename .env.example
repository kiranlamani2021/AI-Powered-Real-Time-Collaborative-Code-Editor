# Copy to .env for local development. In production, set these in the
# hosting dashboard (Render environment variables) — never commit .env.

# Required --------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME
JWT_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=change-me

# CORS: comma-separated list of allowed frontend origins (Vercel URL etc.)
CORS_ORIGIN=http://localhost:5173

# Optional --------------------------------------------------------------
# NODE_ENV=production

# Code execution is DISABLED in production unless explicitly enabled.
# Submitted code runs with timeouts/an allowlisted env but WITHOUT OS-level
# sandbox isolation — only enable on a locked-down container/host.
# ENABLE_CODE_EXECUTION=true

# Execution limits (milliseconds)
# COMPILE_TIMEOUT_MS=60000
# EXECUTION_TIMEOUT_MS=15000

# Runtime binary overrides (platform defaults: PATH lookup on Linux/macOS)
# PYTHON_BIN=python3
# GO_BIN=go
# PHP_BIN=php
